{
  "manifest_version": 3,
  "name": "Retail Action Recorder",
  "version": "1.0",
  "description": "Capture user actions for retail_id and session_id and send to backend.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
} 