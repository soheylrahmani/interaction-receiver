# Copy to .env and replace placeholders. Never commit .env.

POSTGRES_USER=interaction_receiver
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=interaction_receiver
POSTGRES_PORT=5432
API_PORT=8000

# Used by local / non-Docker runs (host is localhost).
# Compose overrides DATABASE_URL inside the api container to use host `postgres`.
DATABASE_URL=postgresql+psycopg2://interaction_receiver:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/interaction_receiver

PROJECT_NAME=Interaction Receiver
DEBUG=False
ENVIRONMENT=production

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# Optional LLM providers (leave empty if unused)
OPENAI_API_KEY=
AVALAI_API_KEY=
AVALAI_API_KEY_4O=
AVALAI_BASE_URL=https://api.avalapis.ir/v1
AVALAI_MODEL=gpt-4o-mini
